{
  "name": "diedinchat",
  "version": "0.5.0",
  "description": "File-bound rules for coding agents. Pin a constraint to the paths it is about; it lives in git, survives session end and tool switches, and re-checks itself. Measured: agents followed pinned rules 18/20 times versus 0/20 without.",
  "type": "module",
  "bin": {
    "diedinchat": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "profiles",
    "templates",
    "skills",
    "examples/honor-rate",
    "examples/honor-invisible",
    "examples/pin-capture",
    "examples/claim-001-tool-count",
    "examples/agent-profiles",
    "docs/*.md",
    "docs/evidence/*.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test",
    "m0": "npm run build && node scripts/m0-stale-noise.mjs . 30 12",
    "chart:summary": "npm run build && node scripts/summary-chart.mjs",
    "chart:outcome": "npm run build && node scripts/outcome-chart.mjs",
    "chart:png": "npm run build && node scripts/svg-to-png.mjs",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "diedinchat",
    "coding-agents",
    "mcp",
    "mcp-server",
    "cli",
    "cursor",
    "claude-code",
    "codex",
    "file-tickets",
    "developer-tools",
    "agents-md",
    "stale-detection",
    "context-handoff"
  ],
  "license": "MIT",
  "author": "Pawan Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawankumar94/diedinchat.git"
  },
  "bugs": {
    "url": "https://github.com/pawankumar94/diedinchat/issues"
  },
  "homepage": "https://github.com/pawankumar94/diedinchat#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
