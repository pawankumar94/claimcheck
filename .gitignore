dist/

# Agent-specific local config. claimcheck is agent-agnostic by design --
# per-agent settings belong on your machine, not in the repo. Shared
# guidance for agents lives in AGENTS.md and docs/architecture.md.
.claude/
.cursor/
.codex/
# Scratch output from a local run. Published results are curated by hand into
# benchmarks/<date>-<agent>/ with the caveats that bound them, so a number never
# ships without its context.
results/
__pycache__/
*.pyc
