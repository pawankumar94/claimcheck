# Agent-specific local config. diedinchat is agent-agnostic by design --
# per-agent settings belong on your machine, not in the repo. Shared
# guidance for agents lives in AGENTS.md and docs/architecture.md.
.claude/
.cursor/
.codex/
# Scratch output from a local lab run. A reviewed result may be promoted into
# docs/evidence/ as one compact record plus stable SVGs; per-invocation dumps
# do not belong at the repository root. File tickets live in .diedinchat/ and
# ARE committed — that is how they survive agent-switch.
results/
__pycache__/
*.pyc

# Scratch preview output.
.tmp-preview/
