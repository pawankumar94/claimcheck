{
  "name": "@pawankumar94/diedinchat",
  "version": "0.1.0",
  "description": "Pin what an agent asserted to the files it was about. Tickets live in git, survive sessions and tool switches, and go stale when those files change.",
  "type": "module",
  "bin": {
    "diedinchat": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "profiles",
    "templates",
    "examples",
    "skills",
    "brand",
    "smithery.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "diedinchat",
    "coding-agents",
    "mcp",
    "mcp-server",
    "cli",
    "cursor",
    "claude-code",
    "codex",
    "file-tickets",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Pawan Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawankumar94/diedinchat.git"
  },
  "bugs": {
    "url": "https://github.com/pawankumar94/diedinchat/issues"
  },
  "homepage": "https://github.com/pawankumar94/diedinchat#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
