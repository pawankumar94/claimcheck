{
  "name": "diedinchat",
  "version": "0.3.1",
  "description": "File-bound tickets for coding agents. Pin a constraint to the paths it is about; it lives in git, survives session end and tool switches, and flips stale when those files change. CLI, MCP server, and install targets for Claude, Cursor, Copilot, Codex, Gemini and AGENTS.md.",
  "type": "module",
  "bin": {
    "diedinchat": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "profiles",
    "templates",
    "skills",
    "examples/honor-rate",
    "examples/claim-001-tool-count",
    "examples/agent-profiles",
    "docs",
    "smithery.yaml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test",
    "m0": "npm run build && node scripts/m0-stale-noise.mjs . 30 12"
  },
  "keywords": [
    "diedinchat",
    "coding-agents",
    "mcp",
    "mcp-server",
    "cli",
    "cursor",
    "claude-code",
    "codex",
    "file-tickets",
    "developer-tools",
    "agents-md",
    "stale-detection",
    "context-handoff"
  ],
  "license": "MIT",
  "author": "Pawan Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawankumar94/diedinchat.git"
  },
  "bugs": {
    "url": "https://github.com/pawankumar94/diedinchat/issues"
  },
  "homepage": "https://github.com/pawankumar94/diedinchat#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
